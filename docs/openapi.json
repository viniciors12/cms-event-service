    }
  },
  "components": {
    "schemas": {
      "CmsEvent": {
        "required": [
          "type",
          "id",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "publish",
              "add",
              "update",
              "unPublish",
              "delete"
            ],
            "type": "string",
            "description": "Case-insensitive. add and update are treated as publish."
          },
          "id": {
            "pattern": "^[A-Za-z0-9._:-]{1,100}$",
            "type": "string",
            "description": "Entity id in the CMS."
          },
          "version": {
            "minimum": 1,
            "type": "integer",
            "description": "Required for publish, add, update and unPublish; ignored for delete.",
            "format": "int32"
          },
          "payload": {
            "type": "object",
            "description": "Required for publish, add, update and unPublish; up to 262144 characters. An unPublish carries the payload of the version being unpublished."
          },
          "timestamp": {
            "type": "string",
            "description": "When the event happened in the CMS (ISO-8601).",
            "format": "date-time"
          }
        },
        "description": "One CMS event. Each event in a batch is validated on its own."
      },
      "BatchResult": {
        "required": [
          "results"
        ],
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResult"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "applied": {
            "type": "integer",
            "format": "int32"
          },
          "ignored": {
            "type": "integer",
            "format": "int32"
          },
          "rejected": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EntityResponse": {
        "required": [
          "id",
          "version",
          "payload",
          "isPublished",
          "isDisabledByAdmin",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "payload": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "isPublished": {
            "type": "boolean"
          },
          "isDisabledByAdmin": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventOutcome": {
        "type": "integer"
      },
      "EventResult": {
        "required": [
          "index",
          "id",
          "type",
          "outcome",
          "reason"
        ],
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "$ref": "#/components/schemas/EventOutcome"
          },
          "reason": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "JsonElement": {},
      "PagedResultOfEntityResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "Basic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "Basic": []
    }
  ],
  "tags": [
    {
      "name": "CmsEvents"
    },
    {
      "name": "Entities"
    }
  ]
}
